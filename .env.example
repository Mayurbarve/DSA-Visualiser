[TEMPLATE]
# Server-side only. Copy to .env.local and fill in.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary model. Any slug from openrouter.ai/models works.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Secondary model - tried in parallel for fastest response
OPENROUTER_SECOND_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Tertiary model - third option in the model chain
OPENROUTER_THIRD_MODEL=cohere/north-mini-code:free

# Fourth model - additional free coding model
OPENROUTER_FOURTH_MODEL=thinkingmachines/inkling:free

# Fifth model - backup free code model
OPENROUTER_FIFTH_MODEL=qwen/qwen3.8-27b:free

# Comma-separated fallback list (tried in order when primary/secondary fail)
OPENROUTER_FALLBACK_MODEL=cohere/north-mini-code:free,nvidia/nemotron-3-ultra-550b-a55b:free,thinkingmachines/inkling:free